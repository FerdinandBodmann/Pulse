rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 300)) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
             (!('bannerColor' in data) || data.bannerColor == null || (data.bannerColor is string && data.bannerColor.size() <= 50)) &&
             (!('followersCount' in data) || data.followersCount is int) &&
             (!('followingCount' in data) || data.followingCount is int) &&
             (!('postsCount' in data) || data.postsCount is int) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidPost(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 50 &&
             data.authorHandle is string && data.authorHandle.size() >= 1 && data.authorHandle.size() <= 50 &&
             (!('authorAvatar' in data) || data.authorAvatar == null || (data.authorAvatar is string && data.authorAvatar.size() <= 1000)) &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 1000 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
             (!('mediaType' in data) || data.mediaType == null || (data.mediaType is string && data.mediaType.size() <= 20)) &&
             (!('mediaUrl' in data) || data.mediaUrl == null || (data.mediaUrl is string && data.mediaUrl.size() <= 1000)) &&
             (!('videoDuration' in data) || data.videoDuration == null || (data.videoDuration is string && data.videoDuration.size() <= 20)) &&
             (!('mediaColor' in data) || data.mediaColor == null || (data.mediaColor is string && data.mediaColor.size() <= 50)) &&
             (!('likesCount' in data) || data.likesCount is int) &&
             (!('commentsCount' in data) || data.commentsCount is int) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidPostLike(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.postId is string && data.postId.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidComment(data) {
      return data.postId is string && data.postId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 50 &&
             (!('authorAvatar' in data) || data.authorAvatar == null || (data.authorAvatar is string && data.authorAvatar.size() <= 1000)) &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidStory(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 50 &&
             (!('authorAvatar' in data) || data.authorAvatar == null || (data.authorAvatar is string && data.authorAvatar.size() <= 1000)) &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 200 &&
             (!('mediaColor' in data) || data.mediaColor == null || (data.mediaColor is string && data.mediaColor.size() <= 50)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidFollowRecord(data) {
      return data.targetUserId is string && data.targetUserId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             (!('targetUsername' in data) || data.targetUsername == null || (data.targetUsername is string && data.targetUsername.size() <= 50)) &&
             (!('targetDisplayName' in data) || data.targetDisplayName == null || (data.targetDisplayName is string && data.targetDisplayName.size() <= 50)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 1. User Profiles
    match /users/{userId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'username', 'displayName', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'bio', 'avatarUrl', 'bannerColor', 'followersCount', 'followingCount', 'postsCount', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;

      // Subcollection: following
      match /following/{targetUserId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().targetUserId == targetUserId &&
                         isValidFollowRecord(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // 2. Posts Collection
    match /posts/{postId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'authorName', 'authorHandle', 'content', 'category', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidPost(incoming());

      allow update: if isSignedIn() &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidPost(incoming()) && (
                         // Action 1: Author edits post content/category/media
                         (incoming().userId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['content', 'category', 'mediaType', 'mediaUrl', 'videoDuration', 'mediaColor', 'updatedAt'])) ||
                         // Action 2: Increments/decrements likesCount
                         (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])) ||
                         // Action 3: Increments/decrements commentsCount
                         (incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && existing().userId == request.auth.uid;

      // Subcollection: Likes
      match /likes/{userId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().postId == postId &&
                         isValidPostLike(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Subcollection: Comments
      match /comments/{commentId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() &&
                         incoming().userId == request.auth.uid &&
                         incoming().postId == postId &&
                         incoming().keys().hasAll(['postId', 'userId', 'authorName', 'text', 'createdAt']) &&
                         isValidComment(incoming());
        allow update: if false;
        allow delete: if isSignedIn() &&
                         (existing().userId == request.auth.uid ||
                          get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid);
      }
    }

    // 3. Stories Collection
    match /stories/{storyId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'authorName', 'content', 'createdAt']) &&
                       isValidStory(incoming());
      allow update: if false;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
